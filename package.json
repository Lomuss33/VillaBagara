{
    "name": "villa-bagara",
    "private": true,
    "version": "2.0.3",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "images:responsive": "node scripts/generate-responsive-images.mjs",
        "check:static": "node scripts/check-static.mjs",
        "check:docs": "node scripts/check-docs.mjs",
        "check:keyboard": "node --test scripts/tests/*.test.mjs",
        "check:browser": "playwright test",
        "check:lighthouse": "npm exec --yes --package=@lhci/cli@0.15.1 -- lhci autorun --config=.lighthouserc.cjs",
        "fonts:generate": "node scripts/generate-fonts.mjs",
        "check": "npm run lint && npm run check:docs && npm run check:keyboard && npm run check:static && npm run build && node scripts/check-static.mjs --dist",
        "preview": "vite preview",
        "resume:make:article": "node npm/npm-resume-new-article.js",
        "resume:clear": "node npm/npm-resume-clear.js"
    },
    "dependencies": {
        "@emailjs/browser": "^5.0.2",
        "@fortawesome/fontawesome-free": "^6.6.0",
        "bootstrap": "^5.3.3",
        "react": "^18.3.1",
        "react-bootstrap": "^2.10.4",
        "react-dom": "^18.3.1",
        "smooth-scrollbar": "^8.8.4",
        "swiper": "^12.2.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.13.0",
        "@eslint/js": "^9.9.0",
        "@playwright/test": "1.64.0",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "@vitejs/plugin-react": "^4.3.1",
        "eslint": "^9.9.0",
        "eslint-plugin-react": "^7.35.0",
        "eslint-plugin-react-hooks": "^5.1.0-rc.0",
        "eslint-plugin-react-refresh": "^0.4.9",
        "globals": "^15.9.0",
        "sass-embedded": "^1.78.0",
        "vite": "^6.3.5"
    }
}
